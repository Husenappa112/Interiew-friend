{
  "services": {
    "interview-friend-api": {
      "root": "backened",
      "entrypoint": "src/app.js",
      "buildCommand": "npm ci && npx prisma generate"
    },
    "interview-friend-web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "interview-friend-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "interview-friend-web"
      }
    }
  ]
}
